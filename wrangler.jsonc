{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowledge",
  "main": "worker.ts",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
